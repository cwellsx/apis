{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "backend-ui": ["../backend/contracts/ui/index.ts"]
    },
    "types": ["vitest/globals", "react", "react-dom"]
  },
  "include": ["src/**/*", "../electron-app/src/renderer/global.d.ts"]
}