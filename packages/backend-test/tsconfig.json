{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    //"rootDirs": ["test", "../backend/src"],
    "strict": true,
    "baseUrl": ".", // needed when paths is specified
    "paths": {
      "backend-api": ["../backend/src/index.ts"],
      "backend-app": ["../backend/contracts/app/index.ts"],
      "backend-ui": ["../backend/contracts/ui/index.ts"],
      "sut/*": ["../backend/src/*"]
    },
    // don't try to compile e.g. @types/react-dom -- by default the compiler would try to compile all types
    "types": ["node", "mocha"],
    "skipLibCheck": true
  },
  "include": ["test", "../backend/src", "../backend/contracts"]
}
